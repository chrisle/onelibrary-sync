{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneLibrary Sync",
  "mainBinaryName": "onelibrary-sync",
  "version": "0.1.0",
  "identifier": "com.rbxport.onelibrarysync",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneLibrary Sync",
        "width": 720,
        "height": 480,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Sync a USB's Device Library from its OneLibrary",
    "longDescription": "Keeps the Device Library (export.pdb) on each connected USB in line with the USB's OneLibrary (exportLibrary.db), so players that read only the Device Library see the same tracks, playlists and My Tags. Only what differs is written.",
    "copyright": "Chris Le",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3MTFEN0NCNTEyQzY4NzEKUldSeGFDeFJ5OWNSOTJTWjVsR0lzSkh0ZEFJSGZBeG9IT0c0cHZJK2tWS1JjK1lrUGkrR3pFelcK",
      "endpoints": [
        "https://download.rbxport.com/onelibrary-sync-latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
